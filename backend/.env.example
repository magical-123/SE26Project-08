# Copy to .env.local in the backend working directory, then fill in local values.
DB_URL=jdbc:mysql://localhost:3306/info_digest?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=infodigest
DB_PASSWORD=
# Optional HikariCP sizing; keep 0 <= MIN_IDLE <= MAX_SIZE and MAX_SIZE >= 1.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Generate fresh values with: python scripts/generate_secrets.py from the repository root
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*,edge-extension://*
CRAWLER_SERVICE_URL=http://localhost:3000/crawl
