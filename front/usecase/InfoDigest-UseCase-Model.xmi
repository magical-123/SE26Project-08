        <UML:Actor xmi.id="ACT_FRIEND" name="好友" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
        <UML:Actor xmi.id="ACT_SYSTEM" name="系统" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>

