<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE XMI SYSTEM "Uml.dtd" []>
<XMI xmi.version="1.2"
     xmlns:UML="org.omg/UML/1.4"
     xmlns:xmi="http://www.omg.org/XMI">

  <XMI.header>
    <XMI.documentation>
      <XMI.exporter>Reasonix Code</XMI.exporter>
      <XMI.exporterVersion>1.0</XMI.exporterVersion>
    </XMI.documentation>
    <XMI.metamodel xmi.name="UML" xmi.version="1.4"/>
  </XMI.header>

  <XMI.content>
    <!-- ============================== 模型 ============================== -->
    <UML:Model xmi.id="M_InfoDigest" name="InfoDigest Use-Case Model" isSpecification="false" isLeaf="false" isRoot="false" isAbstract="false">

      <!-- ====== 包：信息源管理 ====== -->
      <UML:Namespace.ownedElement>
        <UML:Package xmi.id="PKG_SRC" name="信息源管理" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC01" name="UC-01 授权信息源接入" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC02" name="UC-02 自动捕获浏览记录" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC03" name="UC-03 查看信息源元数据" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC05" name="UC-05 接收智能引导提示" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
          </UML:Namespace.ownedElement>
        </UML:Package>

        <!-- ====== 包：报告与分析 ====== -->
        <UML:Package xmi.id="PKG_RPT" name="报告与分析" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC06" name="UC-06 查看每日/周知识总结报告" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC07" name="UC-07 查看信息营养成分表" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC08" name="UC-08 查看关注点流变分析" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
          </UML:Namespace.ownedElement>
        </UML:Package>

        <!-- ====== 包：社交与隐私 ====== -->
        <UML:Package xmi.id="PKG_SOCIAL" name="社交与隐私" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC11" name="UC-11 添加好友" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC12" name="UC-12 查看好友浏览趋势" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC13" name="UC-13 查看好友知识图谱" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC14" name="UC-14 管理隐私设置" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
          </UML:Namespace.ownedElement>
        </UML:Package>

        <!-- ====== 包：笔记与标注 ====== -->
        <UML:Package xmi.id="PKG_NOTE" name="笔记与标注" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC04" name="UC-04 记录笔记并标注优质源" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
          </UML:Namespace.ownedElement>
        </UML:Package>

        <!-- ====== 包：知识图谱 ====== -->
        <UML:Package xmi.id="PKG_GRAPH" name="知识图谱" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC09" name="UC-09 浏览个人知识图谱" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC10" name="UC-10 AI 构建知识图谱" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
          </UML:Namespace.ownedElement>
        </UML:Package>

        <!-- ====== 包：进阶功能 ====== -->
        <UML:Package xmi.id="PKG_ADV" name="进阶功能" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false">
          <UML:Namespace.ownedElement>
            <UML:UseCase xmi.id="UC15" name="UC-15 接收跨平台智能推荐" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
            <UML:UseCase xmi.id="UC16" name="UC-16 多模态内容理解" isSpecification="false" isRoot="false" isLeaf="false" isAbstract="false"/>
