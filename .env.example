# 外部数据库连接（请填入宿主机的真实内网或公网 IP 地址，不要填 localhost）
DB_URL=jdbc:mysql://127.0.0.1:3306/info_digest?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=REPLACE_ME

# 外部 Redis 缓存连接
REDIS_HOST=127.0.0.1

# JWT 和 加密密钥 (生产环境请务必修改!)
JWT_SECRET=REPLACE_ME
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME

# CORS 配置，如果是公网部署请写上你的域名，例如 http://yourdomain.com
CORS_ALLOWED_ORIGIN_PATTERNS=*

# AI API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ====== 阿里云 CI/CD 更新专用 ======
# 请填入你在阿里云容器镜像服务(ACR)中创建的命名空间
ALIYUN_NAMESPACE=你的命名空间
