# Copy to .env for Docker Compose; never commit the resulting file.
DB_URL=jdbc:mysql://host.docker.internal:3306/info_digest?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=infodigest
DB_PASSWORD=
# Optional HikariCP sizing; keep 0 <= MIN_IDLE <= MAX_SIZE and MAX_SIZE >= 1.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate fresh values with: python scripts/generate_secrets.py
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Set your actual frontend origin, e.g. https://app.example.com.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost
DEEPSEEK_API_KEY=
# For Compose, omit CRAWLER_SERVICE_URL to use the internal crawler service.
